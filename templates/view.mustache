{{!
    @template mod_checkin/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-checkin">
    {{#intro}}
        <div class="mb-4">{{{intro}}}</div>
    {{/intro}}

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}windowlabel, mod_checkin{{/str}}</h3>
            <p class="mb-1"><strong>{{windowstatus}}</strong></p>
            <p class="mb-0 text-muted">{{windowtext}}</p>
        </div>
    </div>

    {{#privacywarning}}
        <div class="alert alert-info">{{#str}}privacywarning, mod_checkin{{/str}}</div>
    {{/privacywarning}}

    {{#canmanage}}
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h3 class="h5 mb-0">{{#str}}teachercontrols, mod_checkin{{/str}}</h3>
                    {{#canviewreports}}
                        <a class="btn btn-secondary btn-sm" href="{{reporturl}}">{{#str}}report, mod_checkin{{/str}}</a>
                    {{/canviewreports}}
                </div>

                {{#usecode}}
                    <div class="mod-checkin-code mb-4">
                        <h4>{{#str}}code, mod_checkin{{/str}}</div>
                        <div class="display-5 fw-bold mod-checkin-code-value">{{checkincode}}</div>
                        <form method="post" action="{{viewurl}}" class="mt-2">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="regeneratecode">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">{{#str}}regeneratecode, mod_checkin{{/str}}</button>
                        </form>
                    </div>
                {{/usecode}}

                {{#requireteacherip}}
                    <div class="mb-4">
                        <h4>{{#str}}registeredip, mod_checkin{{/str}}</h4>
                        <p class="mb-1"><strong>{{teacherip}}</strong></p>
                        <p class="text-muted small mb-2">{{#str}}currentip, mod_checkin{{/str}}: {{currentip}}</p>
                        <form method="post" action="{{viewurl}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="registerip">
                            <button type="submit" class="btn btn-outline-primary btn-sm">{{#str}}registerthisip, mod_checkin{{/str}}</button>
                        </form>
                    </div>
                {{/requireteacherip}}

                {{#requirelocation}}
                    <div>
                        <h4>{{#str}}registeredlocation, mod_checkin{{/str}}</h4>
                        <p class="mb-1"><strong>{{teacherlocation}}</strong></p>
                        {{#teacheraccuracy}}
                            <p class="text-muted small mb-1">{{#str}}accuracy, mod_checkin{{/str}}: {{teacheraccuracy}} {{#str}}metres, mod_checkin{{/str}}</p>
                        {{/teacheraccuracy}}
                        <p class="text-muted small mb-2">{{#str}}radius, mod_checkin{{/str}}: {{locationradius}} {{#str}}metres, mod_checkin{{/str}}</p>
                        <form method="post" action="{{viewurl}}" data-checkin-location-form="1"
                              data-location-error="{{geolocationerror}}" data-location-unsupported="{{geolocationunsupported}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="setlocation">
                            <input type="hidden" name="latitude" value="">
                            <input type="hidden" name="longitude" value="">
                            <input type="hidden" name="accuracy" value="">
                            <button type="submit" class="btn btn-outline-primary btn-sm">{{#str}}capturelocation, mod_checkin{{/str}}</button>
                        </form>
                    </div>
                {{/requirelocation}}
            </div>
        </div>
    {{/canmanage}}

    {{#cancheckin}}
        <div class="card mod-checkin-student-card">
            <div class="card-body">
                {{#alreadycheckedin}}
                    <div class="alert alert-success mb-0">
                        <strong>{{#str}}alreadycheckedin, mod_checkin{{/str}}</strong><br>
                        <span class="small">{{checkintime}}</span>
                    </div>
                {{/alreadycheckedin}}

                {{^alreadycheckedin}}
                    {{#windowopen}}
                        <form method="post" action="{{viewurl}}" data-checkin-student-form="1"
                              data-require-location="{{#requirelocation}}1{{/requirelocation}}{{^requirelocation}}0{{/requirelocation}}"
                              data-location-error="{{geolocationerror}}" data-location-unsupported="{{geolocationunsupported}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="checkin">
                            <input type="hidden" name="latitude" value="">
                            <input type="hidden" name="longitude" value="">
                            <input type="hidden" name="accuracy" value="">

                            {{#usecode}}
                                <div class="mb-3">
                                    <label class="form-label" for="mod-checkin-code">{{#str}}entercode, mod_checkin{{/str}}</label>
                                    <input id="mod-checkin-code" class="form-control mod-checkin-code-input" type="text" name="code"
                                           inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required>
                                </div>
                            {{/usecode}}

                            <button type="submit" class="btn btn-primary btn-lg">{{#str}}checkin, mod_checkin{{/str}}</button>
                        </form>
                    {{/windowopen}}
                    {{^windowopen}}
                        <div class="alert alert-secondary mb-0">{{windowstatus}}</div>
                    {{/windowopen}}
                {{/alreadycheckedin}}
            </div>
        </div>
    {{/cancheckin}}
</div>
